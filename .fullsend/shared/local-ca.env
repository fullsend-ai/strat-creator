# Sourced in the sandbox before Claude starts. When the local-service CA was
# mounted, append it to the sandbox trust bundle (keeping OpenShell's CA, which
# Vertex traffic needs) and point Python, curl, Git and Node at the result.
# Carried from the script-led POC's ca-bundle.sh (see SOURCE-PROVENANCE.md).
if [ -r /tmp/local-ca.crt ]; then
  _strat_base="${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt}"
  if [ -r "$_strat_base" ] && cat "$_strat_base" /tmp/local-ca.crt > /tmp/strat-ca-bundle.pem; then
    chmod 0600 /tmp/strat-ca-bundle.pem
    export SSL_CERT_FILE=/tmp/strat-ca-bundle.pem
    export REQUESTS_CA_BUNDLE=/tmp/strat-ca-bundle.pem
    export CURL_CA_BUNDLE=/tmp/strat-ca-bundle.pem
    export GIT_SSL_CAINFO=/tmp/strat-ca-bundle.pem
    export NODE_EXTRA_CA_CERTS=/tmp/strat-ca-bundle.pem
  fi
  unset _strat_base
fi
