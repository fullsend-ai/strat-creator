{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strat-creator-result.schema.json",
  "title": "strat-creator agent result",
  "description": "Written by scripts/strat_pipeline_state.py result inside the sandbox. Schema validity is necessary, not sufficient: validate_result.py checks every claim against the host run record, the progress file, the artifacts and Jira.",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "mode", "run_id", "summary", "input_keys", "acquired_keys", "skipped",
               "strategies", "completed_phases", "artifacts", "architecture_context", "dry_run",
               "errors"],
  "properties": {
    "action": {"type": "string", "enum": ["completed", "failed", "skipped"]},
    "mode": {"type": "string", "enum": ["single", "batch", "resume"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "input_keys": {"$ref": "#/$defs/rfe_keys"},
    "acquired_keys": {"$ref": "#/$defs/rfe_keys"},
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "reason"],
        "properties": {
          "key": {"$ref": "#/$defs/rfe_key"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rfe", "strat", "recommendation", "needs_attention"],
        "properties": {
          "rfe": {"$ref": "#/$defs/rfe_key"},
          "strat": {"type": "string", "pattern": "^(RHAISTRAT|STRAT)-[0-9]+$"},
          "recommendation": {"type": "string", "enum": ["approve", "revise", "reject"]},
          "needs_attention": {"type": "boolean"}
        }
      }
    },
    "completed_phases": {
      "type": "array",
      "items": {"type": "string", "enum": ["create", "refine", "push", "review"]},
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {"type": "string", "pattern": "^artifacts/[A-Za-z0-9._/-]+$"}
    },
    "architecture_context": {"type": "string", "enum": ["available", "missing"]},
    "dry_run": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string", "maxLength": 1000}}
  },
  "$defs": {
    "rfe_key": {"type": "string", "pattern": "^RHAIRFE-[0-9]+$"},
    "rfe_keys": {"type": "array", "items": {"$ref": "#/$defs/rfe_key"}, "uniqueItems": true}
  }
}
